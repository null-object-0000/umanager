{
  "sources": {
    "tencent": {
      "name": "腾讯源",
      "role": "vendor"
    },
    "common": {
      "name": "公共源",
      "role": "common"
    }
  },
  "applications": [
    {
      "applicationId": "github-cli",
      "packageName": "gh",
      "displayName": "GitHub CLI",
      "vendor": "GitHub",
      "architecture": "amd64",
      "description": "GitHub 官方命令行工具，在终端里直接管理仓库、Issue、PR、Actions。",
      "category": "cli",
      "homepage": "https://cli.github.com/",
      "icon": "github-cli",
      "accentColor": "#24292e",
      "removable": true,
      "source": {
        "kind": "aptRepository",
        "repositoryUrl": "https://cli.github.com/packages",
        "repositoryHosts": ["cli.github.com"],
        "packagesIndexUrl": "https://cli.github.com/packages/dists/stable/main/binary-amd64/Packages.gz"
      },
      "releaseNotes": {
        "releaseApiUrl": "https://api.github.com/repos/cli/cli/releases/latest"
      }
    },
    {
      "applicationId": "localsend",
      "packageName": "localsend",
      "displayName": "LocalSend",
      "vendor": "LocalSend",
      "architecture": "amd64",
      "description": "开源跨平台局域网文件传输工具，无需互联网即可在设备间安全互传文件，端到端加密。",
      "homepage": "https://localsend.org/",
      "icon": "localsend",
      "accentColor": "#0fa3a3",
      "removable": true,
      "source": {
        "kind": "releaseApi",
        "releaseApiUrl": "https://api.github.com/repos/localsend/localsend/releases/latest",
        "releaseApiHosts": ["api.github.com"],
        "assetNamePattern": "LocalSend-{tagVersion}-linux-x86-64.deb",
        "stripTagPrefix": "v",
        "assetDownloadHosts": ["github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"],
        "allowPrerelease": false
      }
    },
    {
      "applicationId": "bitwarden",
      "packageName": "bitwarden",
      "displayName": "Bitwarden",
      "vendor": "Bitwarden",
      "architecture": "amd64",
      "description": "开源密码管理器，跨平台安全存储密码与敏感信息，端到端加密。",
      "homepage": "https://bitwarden.com/download/",
      "icon": "bitwarden",
      "accentColor": "#175ddc",
      "removable": true,
      "source": {
        "kind": "stableDownloadEndpoint",
        "officialPageUrl": "https://bitwarden.com/download/",
        "officialPageHosts": ["bitwarden.com"],
        "downloadUrl": "https://bitwarden.com/download/?app=desktop&platform=linux&variant=deb",
        "downloadHosts": ["bitwarden.com", "github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"],
        "pageVersionMarker": "",
        "downloadLinkFileName": "Bitwarden-2026.8.0-amd64.deb"
      },
      "releaseNotes": {
        "releaseApiUrl": "https://api.github.com/repos/bitwarden/clients/releases?per_page=30",
        "tagPrefix": "desktop-"
      }
    },
    {
      "applicationId": "qq",
      "packageName": "linuxqq",
      "displayName": "QQ",
      "vendor": "腾讯",
      "sourceGroup": "tencent",
      "architecture": "amd64",
      "description": "腾讯 QQ Linux 桌面版，支持文字、语音、视频聊天与文件传输。",
      "homepage": "https://im.qq.com/index/#/linux",
      "icon": "qq",
      "accentColor": "#12b7f5",
      "removable": true,
      "source": {
        "kind": "versionEndpoint",
        "versionEndpointUrl": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/pcConfig.json",
        "versionEndpointHosts": ["qq-web.cdn-go.cn"],
        "gatewayUrl": "https://umanager.nichangen.workers.dev",
        "payloadKind": "json",
        "versionField": "Linux.version",
        "downloadUrlField": "Linux.x64DownloadUrl.deb",
        "downloadHosts": ["qqdl.gtimg.cn"],
        "sign": {
          "kind": "qqUrlSign",
          "endpointUrl": "https://im.qq.com/http2rpc/gotrpc/noauth/trpc.qqntv2.urlsign.UrlSign/GetSign",
          "endpointHosts": ["im.qq.com"],
          "method": "POST",
          "headers": { "x-oidb": "{\"uint32_command\":\"0x9b8e\",\"uint32_service_type\":1}" },
          "bodyTemplate": "{\"url\":\"{downloadUrl}\"}",
          "signedUrlField": "data.url"
        }
      },
      "releaseNotes": {
        "changelogJsonpUrl": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/linuxLog.js",
        "releaseNotesUrl": "https://im.qq.com/index/#/log?platform=linux"
      }
    },
    {
      "applicationId": "qq-music",
      "packageName": "qqmusic",
      "displayName": "QQ 音乐",
      "vendor": "腾讯",
      "sourceGroup": "tencent",
      "architecture": "amd64",
      "description": "腾讯官方音乐客户端，海量曲库与高品质音质，支持歌单与个性化推荐。",
      "homepage": "https://y.qq.com/download/download.html",
      "icon": "qq-music",
      "accentColor": "#31c27c",
      "removable": true,
      "source": {
        "kind": "versionEndpoint",
        "versionEndpointUrl": "https://y.qq.com/download/download.html",
        "versionEndpointHosts": ["y.qq.com"],
        "gatewayUrl": "https://umanager.nichangen.workers.dev",
        "payloadKind": "html",
        "downloadUrlField": ".deb",
        "downloadHosts": ["c.y.qq.com", "dldir.y.qq.com"]
      },
      "releaseNotes": {
        "changelogListHtmlUrl": "https://y.qq.com/download/download.html",
        "blockMarker": "ic-linux",
        "releaseNotesUrl": "https://y.qq.com/download/download.html"
      }
    },
    {
      "applicationId": "obsidian",
      "packageName": "obsidian",
      "displayName": "Obsidian",
      "vendor": "Obsidian",
      "architecture": "amd64",
      "description": "基于 Markdown 的本地知识库笔记应用，用双向链接构建个人知识网络，本地优先、数据自持。",
      "homepage": "https://obsidian.md/",
      "icon": "obsidian",
      "accentColor": "#7c3aed",
      "removable": true,
      "source": {
        "kind": "versionEndpoint",
        "versionEndpointUrl": "https://obsidian.md/download",
        "versionEndpointHosts": ["obsidian.md"],
        "payloadKind": "html",
        "downloadUrlField": "_amd64.deb",
        "downloadHosts": ["github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"]
      },
      "releaseNotes": {
        "atomUrl": "https://obsidian.md/changelog.xml",
        "titleContains": ["Desktop", "Public"]
      }
    },
    {
      "applicationId": "feishu",
      "packageName": "bytedance-feishu-stable",
      "displayName": "飞书",
      "vendor": "字节跳动",
      "architecture": "amd64",
      "description": "字节跳动出品的一站式协作办公平台，整合即时沟通、日历、云文档、音视频会议与工作台。",
      "homepage": "https://www.feishu.cn/",
      "icon": "feishu",
      "accentColor": "#2863f5",
      "removable": true,
      "source": {
        "kind": "versionEndpoint",
        "versionEndpointUrl": "https://www.feishu.cn/api/package_info",
        "versionEndpointHosts": ["www.feishu.cn"],
        "query": { "platform": 10 },
        "payloadKind": "json",
        "downloadUrlField": "data.download_link",
        "downloadHosts": ["*.feishucdn.com"],
        "resolveAtDownload": true
      }
    },
    {
      "applicationId": "microsoft-edge",
      "packageName": "microsoft-edge-stable",
      "displayName": "Microsoft Edge",
      "vendor": "Microsoft",
      "architecture": "amd64",
      "description": "微软官方浏览器，与 Windows/Mac 一致的极简设计与跨设备同步，由 Microsoft 官方 apt 仓库分发。",
      "homepage": "https://www.microsoft.com/edge",
      "icon": "microsoft-edge",
      "accentColor": "#0078d4",
      "removable": true,
      "source": {
        "kind": "aptRepository",
        "repositoryUrl": "https://packages.microsoft.com/repos/edge",
        "repositoryHosts": ["packages.microsoft.com"],
        "packagesIndexUrl": "https://packages.microsoft.com/repos/edge/dists/stable/main/binary-amd64/Packages.gz"
      }
    },
    {
      "applicationId": "dingtalk",
      "packageName": "com.alibabainc.dingtalk",
      "displayName": "钉钉",
      "vendor": "阿里巴巴",
      "architecture": "amd64",
      "description": "阿里出品的智能移动办公平台，支持消息、音视频会议、考勤审批与云盘。官方 Linux 版已停更，仅识别与卸载本机已安装的 .deb。",
      "homepage": "https://www.dingtalk.com/download",
      "icon": "dingtalk",
      "accentColor": "#0089ff",
      "removable": true,
      "source": {
        "kind": "browserImport",
        "homepageUrl": "https://www.dingtalk.com/download"
      }
    },
    {
      "applicationId": "codebuddy-ide",
      "packageName": "codebuddy-cn",
      "displayName": "CodeBuddy IDE",
      "vendor": "腾讯",
      "sourceGroup": "tencent",
      "architecture": "amd64",
      "description": "腾讯出品的 AI 编程 IDE，基于 VS Code 深度定制，内置代码补全、技术问答与多智能体协作。",
      "homepage": "https://www.codebuddy.cn/ide/",
      "icon": "codebuddy-ide",
      "accentColor": "#6C4DFF",
      "removable": true,
      "source": {
        "kind": "versionEndpoint",
        "versionEndpointUrl": "https://www.codebuddy.cn/v2/update",
        "versionEndpointHosts": ["www.codebuddy.cn"],
        "gatewayUrl": "https://umanager.nichangen.workers.dev",
        "query": { "platform": "ide-linux-x64" },
        "payloadKind": "json",
        "versionField": "version",
        "downloadUrlField": "url",
        "downloadHosts": ["download.codebuddy.cn"]
      },
      "releaseNotes": {
        "changelogHtmlUrl": "https://www.codebuddy.cn/docs/ide/release-notes/release-notes",
        "versionField": "version"
      }
    },
    {
      "applicationId": "wine",
      "packageName": "winehq-devel",
      "displayName": "Wine",
      "vendor": "WineHQ",
      "architecture": "amd64",
      "description": "开源 Windows 兼容层，在 Linux 上直接运行 Windows 程序，无需虚拟机。由 WineHQ 官方 apt 仓库按 Ubuntu 版本分发。",
      "homepage": "https://www.winehq.org/",
      "icon": "wine",
      "accentColor": "#722f37",
      "removable": true,
      "source": {
        "kind": "aptRepository",
        "repositoryUrl": "https://dl.winehq.org/wine-builds/ubuntu",
        "repositoryHosts": ["dl.winehq.org"],
        "packagesIndexUrl": "https://dl.winehq.org/wine-builds/ubuntu/dists/resolute/main/binary-amd64/Packages.gz"
      }
    },
    {
      "applicationId": "tencent-docs",
      "packageName": "tdappdesktop",
      "displayName": "腾讯文档",
      "vendor": "腾讯",
      "sourceGroup": "tencent",
      "architecture": "amd64",
      "description": "腾讯出品的多人在线协作文档，支持 Word、Excel、PPT 与智能表格的云端实时协作，桌面端可离线编辑。",
      "homepage": "https://docs.qq.com/home",
      "icon": "tencent-docs",
      "accentColor": "#1e6fff",
      "removable": true,
      "source": {
        "kind": "stableDownloadEndpoint",
        "officialPageUrl": "https://docs.qq.com/home/download",
        "officialPageHosts": ["docs.qq.com"],
        "downloadUrl": "https://docs.qq.com/api/package/get?channel_id=30001&version_id=latest&package_name=TencentDocs-x64.deb",
        "downloadHosts": ["*.docs.qq.com"],
        "pageVersionMarker": "",
        "downloadLinkFileName": "TencentDocs-x64.deb"
      }
    }
  ],
  "releaseNotesOverrides": {
    "wechat": {
      "versionedHtmlUrl": "https://weixin.qq.com/updates?platform=linux&version={version}"
    },
    "google-chrome": {
      "atomUrl": "https://chromereleases.googleblog.com/feeds/posts/default",
      "titleContains": ["Stable Channel Update for Desktop"]
    },
    "vscode": {
      "versionedMarkdownUrl": "https://raw.githubusercontent.com/microsoft/vscode-docs/main/release-notes/v{major}_{minor}.md",
      "releaseNotesUrl": "https://code.visualstudio.com/updates/v{major}_{minor}"
    },
    "wps": {
      "changelogBlockHtmlUrl": "https://linux.wps.cn/wpslinuxlog",
      "blockMarker": "<h2 class=\"log_title\""
    }
  },
  "toolReleaseNotesOverrides": {
    "claude-code": {
      "changelogMarkdownUrl": "https://raw.githubusercontent.com/anthropics/claude-code/main/CHANGELOG.md",
      "releaseNotesUrl": "https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md"
    },
    "opencode": {
      "releaseApiUrl": "https://api.github.com/repos/anomalyco/opencode/releases?per_page=30",
      "tagPrefix": "v"
    },
    "codex": {
      "releaseApiUrl": "https://api.github.com/repos/openai/codex/releases?per_page=30",
      "tagPrefix": "rust-v"
    },
    "pi": {
      "changelogMarkdownUrl": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/CHANGELOG.md",
      "releaseNotesUrl": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/CHANGELOG.md"
    },
    "dsh": {
      "releaseApiUrl": "https://api.github.com/repos/deepseek-ai/deepseek-harness/releases?per_page=30",
      "tagPrefix": "dsh-v"
    },
    "hermes": {
      "releaseApiUrl": "https://api.github.com/repos/NousResearch/hermes-agent/releases?per_page=30",
      "tagPrefix": "v"
    },
    "uv": {
      "releaseApiUrl": "https://api.github.com/repos/astral-sh/uv/releases?per_page=30"
    },
    "pnpm": {
      "releaseApiUrl": "https://api.github.com/repos/pnpm/pnpm/releases?per_page=30",
      "tagPrefix": "v"
    }
  },
  "toolVersionOverrides": {
    "hermes": {
      "releaseApiUrl": "https://api.github.com/repos/NousResearch/hermes-agent/releases?per_page=30",
      "versionTitleRegex": "^Hermes Agent v(\\d+\\.\\d+\\.\\d+)"
    },
    "uv": {
      "releaseApiUrl": "https://api.github.com/repos/astral-sh/uv/releases/latest",
      "versionTitleRegex": "^(\\d+\\.\\d+\\.\\d+)"
    },
    "pnpm": {
      "releaseApiUrl": "https://api.github.com/repos/pnpm/pnpm/releases/latest",
      "versionTitleRegex": "^pnpm (\\d+\\.\\d+(?:\\.\\d+)?)"
    }
  }
}
