<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>UManager</vendor>
  <vendor_url>https://github.com/null-object-0000/umanager</vendor_url>
  <action id="io.github.umanager.install-verified-deb">
    <description>Validate, install, or remove a package confirmed in UManager, including UManager itself</description>
    <message>Authentication is required to perform the package operation explicitly confirmed in UManager</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/umanager-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
